---
// A printer's registration target: the mark every film is aligned to.
interface Props { class?: string }
const { class: cls = "" } = Astro.props;
---
<svg class:list={["reg", cls]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <circle cx="12" cy="12" r="6.5" fill="none" stroke="currentColor" stroke-width="1.2" />
  <path d="M12 1v22M1 12h22" stroke="currentColor" stroke-width="1.2" />
</svg>
