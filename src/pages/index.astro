---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Clip from "../components/Clip.astro";
import Marks from "../components/Marks.astro";
import Icon from "../components/Icon.astro";
import Reg from "../components/Reg.astro";
import { EXPERIENCE, EDUCATION, TOKENS } from "../data/profile";
import { getVideos, getPosts, getStars, shortDate } from "../lib/feeds";

const [videos, posts, stars] = await Promise.all([getVideos(3), getPosts(6), getStars()]);
const nav = [
  { label: "Work", href: "#work" },
  { label: "Videos", href: "#videos" },
  { label: "Writing", href: "#writing" },
  { label: "Experience", href: "#experience" },
];
const depths = [-0.06, 0.05, -0.02];
---
<Base
  title="Walid Hadri · Forward Deployed Engineer / AI Engineer"
  description="Walid Hadri builds AI that runs where the data is, like Dowse, local semantic search for Windows, and explains how language models work on The Next Token."
  nav={nav}
>
  <!-- ============ HERO ============ -->
  <section class="hero" data-section aria-labelledby="name">
    <div class="sheet hero-sheet">
      <Marks />
      <h1 id="name" class="hero-name">
        <span class="film film--ink name-a register spot" style="--mx:-16px;--my:10px" data-depth="-0.05">
          <span class="display word">Walid</span>
        </span>
        <span class="film film--teal name-b register spot" style="--mx:14px;--my:-9px;--d:90ms" data-depth="0.06">
          <span class="display word">Hadri</span>
        </span>
      </h1>

      <div class="hero-screen film film--screen spot" aria-hidden="true" data-depth="-0.08"></div>

      <p class="slip role register" style="--mx:8px;--my:12px;--d:170ms" data-depth="0.03">
        <span class="role-title">Forward Deployed Engineer / AI Engineer at MARGO, Paris.</span>
        I build AI that runs where the data is, and I explain how language models work on{" "}
        <a href="https://www.youtube.com/@TheNextTokenLab">The Next Token</a>.
      </p>

      <p class="tokens film film--ink register" style="--mx:-10px;--my:6px;--d:240ms" aria-label="I build local-first AI search and explain how LLMs work">
        {TOKENS.map((t) => (
          <span class:list={["tok mono", !t.startsWith(" ") && "tok--joined"]} aria-hidden="true">{t.trim()}</span>
        ))}
        <span class="tok tok--next mono" aria-hidden="true">work</span><span class="caret" aria-hidden="true"></span>
      </p>

      <div class="hero-dowse" data-depth="0.07">
        <Clip src="/media/dowse-describe.mp4" poster="/media/dowse-describe.webp" width={960} height={594}
          alt="Dowse screen recording: typing 'photos of a yellow tram in Lisbon' finds IMG_0011.jpg, a photo of a yellow tram." develop="in" class="hero-clip" />
        <p class="slip caption">
          <span class="label">Dowse</span> finds a photo by what's in it. Screen recording, real search.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ DOWSE ============ -->
  <section class="dowse" id="work" data-section aria-labelledby="dowse-h">
    <div class="sheet dowse-sheet">
      <h2 id="dowse-h" class="title dowse-title film film--teal spot" data-depth="-0.04">Dowse<Reg /></h2>
      <div class="slip dowse-slip" data-depth="-0.04">
        <Marks />
        <p class="lede">Find anything on your PC by what's in it.</p>
        <p>
          Windows search only looks at file names. Dowse reads photos, screenshots, PDFs, documents, recordings and
          videos, then finds them from a description in your own words, in any language. It runs Google DeepMind's
          EmbeddingGemma 2 on your own machine through llama.cpp. Nothing is uploaded.
        </p>
        <dl class="spec mono">
          <div><dt>Reading a file, graphics card</dt><dd>147 ms</dd></div>
          <div><dt>974 files, 548 MB</dt><dd>2 min 27 s</dd></div>
          <div><dt>Languages</dt><dd>100+</dd></div>
          <div><dt>Files uploaded</dt><dd>0</dd></div>
          <div><dt>GitHub stars</dt><dd>{stars["dowse"] ?? 16}</dd></div>
        </dl>
        <p class="spec-note muted">Timings from Dowse's own benchmark script on an RTX 4070 Ti.</p>
        <div class="actions">
          <a class="action action--yellow" href="/work/dowse">How it works <Icon name="arrow" /></a>
          <a class="action" href="https://github.com/WalidHadri-Iron/dowse">Source <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="dowse-lang" data-depth="-0.07">
        <Clip src="/media/dowse-languages.mp4" poster="/media/dowse-languages.webp" width={960} height={388}
          alt="One bakery receipt found from queries in thirteen languages." />
        <p class="slip caption"><span class="label">Any language</span> One receipt, searched for in 13 languages.</p>
      </div>
      <div class="dowse-docs" data-depth="0.08">
        <Clip src="/media/dowse-documents.mp4" poster="/media/dowse-documents.webp" width={960} height={594}
          alt="Searching 'can I keep a dog in the flat' finds the lease, opened at the pets clause." />
        <p class="slip caption"><span class="label">Inside documents</span> The lease opens at the pets clause.</p>
      </div>
      <div class="dowse-screen film film--grey-screen" aria-hidden="true" data-depth="-0.14"></div>
    </div>
  </section>

  <!-- ============ MORE WORK ============ -->
  <section class="work" data-section aria-labelledby="work-h">
    <div class="sheet work-sheet">
      <h2 id="work-h" class="title work-title film film--ink spot" data-depth="-0.03">More work<Reg /></h2>

      <article class="piece obsidian">
        <div class="obsidian-media" data-depth="-0.05">
          <Clip src="/media/obsidian-visual-search.mp4" poster="/media/obsidian-visual-search.webp" width={960} height={600}
            alt="Dowse for Obsidian: a description of a payment-system diagram brings Board 07 forward in the search gallery." />
        </div>
        <div class="slip piece-slip obsidian-slip" data-depth="0.05">
          <Marks />
          <h3 class="piece-h">Dowse for Obsidian</h3>
          <p>Search an Obsidian vault by meaning: notes, PDFs, images, recordings and canvases, together. Free, in Obsidian's community plugins.</p>
          <p class="meta mono"><Icon name="star" label="Stars" /> {stars["dowse-obsidian"] ?? 19} · TypeScript</p>
          <a class="action" href="https://github.com/WalidHadri-Iron/dowse-obsidian">Plugin source <Icon name="arrow" /></a>
        </div>
      </article>

      <article class="piece tables">
        <figure class="tables-media film" data-depth="0.06">
          <img class="develop spot" src="/media/tables.webp" width="1200" height="880" loading="eager" fetchpriority="low" decoding="async"
            alt="Tables from many sources: scanned forms, handwritten worksheets, nutrition labels, spreadsheets." />
        </figure>
        <div class="slip piece-slip tables-slip" data-depth="-0.03">
          <Marks />
          <h3 class="piece-h">Table detection</h3>
          <p>A field guide to finding tables in documents and in photos, with a YOLO26n model on Hugging Face and a demo you can try.</p>
          <ul class="link-row">
            <li><a href="https://github.com/WalidHadri-Iron/awesome-table-detection-2026">Guide</a></li>
            <li><a href="https://huggingface.co/walidhadri/table-detection-yolo26n">Model</a></li>
            <li><a href="https://huggingface.co/spaces/walidhadri/table-detection-yolov26">Live demo</a></li>
            <li><a href="https://walidhadri.medium.com/table-detection-in-2026-a-practical-guide-to-models-datasets-and-weights-141e881619c8">Article</a></li>
          </ul>
        </div>
      </article>

      <article class="piece ocr">
        <ol class="eras" data-depth="-0.04" aria-label="Three eras of OCR">
          <li class="era film film--ink spot"><span class="mono">1960s–2010s</span><b class="display">Classical</b></li>
          <li class="era film film--teal spot"><span class="mono">2012–2022</span><b class="display">Deep learning</b></li>
          <li class="era film film--screen spot"><span class="mono">2023–</span><b class="display">VLMs</b></li>
        </ol>
        <div class="slip piece-slip ocr-slip" data-depth="0.04">
          <Marks />
          <h3 class="piece-h">Awesome OCR 2026</h3>
          <p>OCR in the VLM era: live leaderboards, the three eras of the field, and a guide to choosing a tool for your documents.</p>
          <a class="action" href="https://github.com/WalidHadri-Iron/awesome-ocr-2026">Read the guide <Icon name="arrow" /></a>
        </div>
      </article>

      <article class="piece kaggle">
        <div class="board film film--ink spot" data-depth="0.05">
          <p class="board-h label">Kaggle Playground S6E10</p>
          <dl class="board-rows mono">
            <div><dt>Public leaderboard</dt><dd>595</dd></div>
            <div class="up"><dt>Private leaderboard</dt><dd>26</dd></div>
            <div><dt>Teams</dt><dd>3,748</dd></div>
          </dl>
        </div>
        <div class="slip piece-slip kaggle-slip" data-depth="-0.03">
          <Marks />
          <h3 class="piece-h">26th of 3,748</h3>
          <p>A model that held up on unseen data: it climbed 569 places when the private leaderboard was revealed.</p>
          <a class="action" href="https://www.kaggle.com/walidhadri">Kaggle profile <Icon name="arrow" /></a>
        </div>
      </article>

    </div>
  </section>

  <!-- ============ VIDEOS ============ -->
  <section class="videos" id="videos" data-section aria-labelledby="videos-h">
    <div class="sheet videos-sheet">
      <h2 id="videos-h" class="title videos-title film film--teal spot" data-depth="-0.04">The Next Token<Reg /></h2>
      <p class="slip videos-intro" data-depth="-0.04"><Marks />
        Animated explainers on how language models read, think and answer. New videos land here on their own.{" "}
        <a href="https://www.youtube.com/@TheNextTokenLab/videos">All videos</a>
      </p>
      <div class="videos-screen film film--grey-screen" aria-hidden="true" data-depth="-0.1"></div>
      <ul class="reel">
        {videos.map((v, i) => (
          <li class={`frame frame-${i}`} data-depth={depths[i % depths.length]}>
            <a href={`https://www.youtube.com/watch?v=${v.id}`} class="frame-link">
              <span class="frame-img film film--ink">
                <Image class="develop spot" src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} width={480} height={360}
                  alt="" loading="lazy" />
              </span>
              <span class="slip frame-slip">
                <span class="frame-date mono">{shortDate(v.published)}</span>
                <span class="frame-title">{v.title}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ WRITING ============ -->
  <section class="writing" id="writing" data-section aria-labelledby="writing-h">
    <div class="sheet writing-sheet">
      <h2 id="writing-h" class="title writing-title film film--ink spot" data-depth="0.04">Writing<Reg /></h2>
      <div class="slip writing-slip" data-depth="0.04">
        <Marks />
        <ol class="posts">
          {posts.map((p) => (
            <li>
              <time class="mono" datetime={p.published}>{shortDate(p.published)}</time>
              <a href={p.url}>{p.title}</a>
            </li>
          ))}
        </ol>
        <a class="action" href="https://walidhadri.medium.com/">All articles on Medium <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- ============ EXPERIENCE ============ -->
  <section class="experience" id="experience" data-section aria-labelledby="exp-h">
    <div class="sheet exp-sheet">
      <h2 id="exp-h" class="title exp-title film film--teal spot" data-depth="-0.03">Experience<Reg /></h2>
      <div class="exp-screen film film--screen spot" aria-hidden="true" data-depth="-0.09"></div>
      <div class="slip exp-slip" data-depth="-0.03">
        <Marks />
        <ol class="ledger">
          {EXPERIENCE.map((e) => (
            <li>
              <span class="mono when">{e.when}</span>
              <span class="what"><b>{e.role}</b> <span class="muted">· {e.org}</span></span>
              <span class="where muted">{e.where}</span>
            </li>
          ))}
        </ol>
        <h3 class="label ledger-h">Education</h3>
        <ol class="ledger">
          {EDUCATION.map((e) => (
            <li>
              <span class="mono when">{e.when}</span>
              <span class="what"><b>{e.role}</b> <span class="muted">· {e.org}</span></span>
              <span class="where"></span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { padding-top: calc(96px + env(safe-area-inset-top, 0px)); position: relative; z-index: 2; }
  @media (max-width: 860px) { .hero { padding-top: calc(132px + env(safe-area-inset-top, 0px)); } }
  .hero-sheet { row-gap: 0; align-items: start; }
  .hero-name { display: contents; }
  .name-a, .name-b { padding: 0.06em 0.12em 0.06em; justify-self: start; }
  .word { display: block; font-size: clamp(5.25rem, 19vw, 17rem); }
  .name-a { grid-column: 1 / 9; grid-row: 1; rotate: -1.6deg; z-index: 1; }
  .name-a .word { color: var(--paper); }
  .name-b { grid-column: 2 / 9; grid-row: 2; margin-top: -0.16em; font-size: clamp(5.25rem, 19vw, 17rem); rotate: 1.1deg; z-index: 2; }
  .name-b .word { font-size: 1em; color: var(--ink); }
  .hero-screen { grid-column: 6 / 10; grid-row: 1 / 3; align-self: end; height: 62%; margin-bottom: 18%; z-index: 0; }
  .role {
    grid-column: 1 / 6; grid-row: 3; margin-top: -1.2rem; z-index: 3; rotate: -0.6deg;
    font-size: clamp(1.0625rem, 1.35vw, 1.25rem); line-height: 1.45; max-width: 40ch;
  }
  .role-title { display: block; font-weight: 720; margin-bottom: 0.3em; }
  .tokens {
    grid-column: 1 / 9; grid-row: 4; justify-self: start; margin-top: 22px; z-index: 3;
    display: flex; flex-wrap: wrap; align-items: center; gap: 6px 0; padding: 10px 12px; rotate: 0.4deg;
  }
  .tok { font-size: clamp(0.875rem, 1.15vw, 1.0625rem); font-weight: 500; padding: 4px 7px; background: var(--paper); color: var(--ink); margin-left: 6px; }
  .tok:first-child { margin-left: 0; }
  .tok--joined { margin-left: 1px; }
  .tok--next { background: transparent; color: var(--yellow); outline: 1.5px dashed var(--yellow); outline-offset: -1.5px; }
  .caret { width: 2px; height: 1.2em; background: var(--yellow); margin-left: 4px; animation: blink 1.1s steps(1) 4; }
  .hero-dowse { grid-column: 8 / 13; grid-row: 2 / 6; align-self: start; margin-top: calc(min(19vw, 17rem) * 0.42); margin-left: calc(min(19vw, 17rem) * -0.09); margin-bottom: -7vw; z-index: 4; rotate: 1.2deg; }
  .hero-clip { box-shadow: 0 30px 60px -30px rgb(18 20 23 / 0.55); }
  .caption { padding: 10px 14px; font-size: 0.9375rem; width: max-content; max-width: 100%; margin: -10px 0 0 18px; position: relative; rotate: -1.4deg; }
  .caption .label { margin-right: 6px; color: var(--teal-ink); }

  /* ---------- dowse ---------- */
  .dowse { padding-top: 72px; position: relative; z-index: 1; }
  .dowse-sheet { row-gap: 0; align-items: start; }
  .dowse-title { grid-column: 1 / 6; grid-row: 1; justify-self: start; padding: 0.08em 0.14em 0.08em; rotate: -1.2deg; z-index: 1; }
  .dowse-slip { grid-column: 1 / 6; grid-row: 2; margin-top: 12px; z-index: 2; }
  .dowse-slip > p:not(.lede):not(.spec-note) { max-width: 60ch; }
  .spec { margin-top: 22px; border-top: 1.5px solid var(--ink); font-size: 0.875rem; }
  .spec div { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-bottom: 1px solid var(--line); }
  .spec dt { color: var(--ink-2); }
  .spec dd { font-weight: 600; }
  .spec-note { font-size: 0.8125rem; margin-top: 10px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .actions .action:not(.action--yellow) { background: var(--base); }
  .dowse-lang { grid-column: 7 / 13; grid-row: 1 / 3; margin-top: -4vw; rotate: -1deg; z-index: 2; }
  .dowse-docs { grid-column: 6 / 12; grid-row: 2 / 4; margin-top: 18vw; rotate: 1.4deg; z-index: 3; }
  .dowse-screen { grid-column: 9 / 13; grid-row: 2 / 4; height: 30vw; margin-top: 8vw; z-index: 1; }

  /* ---------- more work ---------- */
  .work { padding-top: var(--space); }
  .work-sheet { row-gap: clamp(72px, 10vw, 150px); }
  .work-title { grid-column: 1 / 9; justify-self: start; padding: 0.08em 0.14em 0.08em; rotate: 1deg; }
  .piece { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: start; }
  .piece-slip { z-index: 2; }
  .piece-h { font-stretch: 75%; font-weight: 820; font-size: clamp(1.75rem, 2.6vw, 2.5rem); line-height: 1; text-transform: uppercase; margin-bottom: 12px; }
  .piece-slip p { max-width: 52ch; }
  .piece-slip .action { margin-top: 18px; background: var(--base); }
  .meta { margin-top: 12px; font-size: 0.875rem; display: flex; align-items: center; gap: 6px; }
  .meta :global(svg) { width: 14px; height: 14px; color: var(--teal-ink); }
  .link-row { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 16px; font-weight: 650; }

  .obsidian-media { grid-column: 1 / 9; grid-row: 1; rotate: -0.8deg; }
  .obsidian-slip { grid-column: 7 / 12; grid-row: 1; align-self: end; margin-bottom: -48px; rotate: 0.6deg; }

  .tables-media { grid-column: 6 / 13; grid-row: 1; rotate: 1.6deg; background: var(--paper); padding: 10px; }
  .tables-media img { width: 100%; height: auto; }
  .tables-slip { grid-column: 2 / 7; grid-row: 1; margin-top: 18%; rotate: -1deg; }

  .eras { grid-column: 1 / 8; grid-row: 1; display: grid; gap: 0; }
  .era { display: flex; justify-content: space-between; align-items: end; gap: 16px; padding: 14px 18px 8px; }
  .era:nth-child(1) { rotate: -1deg; color: var(--paper); }
  .era:nth-child(2) { rotate: 0.8deg; margin: -10px 0 0 12%; }
  .era:nth-child(3) { rotate: -0.5deg; margin: -10px 0 0 24%; background-color: transparent; }
  .era .display { font-size: clamp(2.5rem, 6vw, 5.5rem); }
  .era .mono { font-size: 0.8125rem; padding-bottom: 0.9em; }
  .ocr-slip { grid-column: 8 / 12; grid-row: 1; margin-top: 12%; rotate: 0.8deg; }

  .board { grid-column: 7 / 12; grid-row: 1; padding: 22px 24px; rotate: 1.2deg; color: var(--paper); z-index: 3; }
  .board-h { color: var(--film-grey); }
  .board-rows { margin-top: 14px; }
  .board-rows div { display: flex; justify-content: space-between; align-items: baseline; padding: 10px 0; border-top: 1px solid rgb(247 247 245 / 0.18); }
  .board-rows dt { font-size: 0.875rem; color: var(--film-grey); }
  .board-rows dd { font-size: clamp(1.75rem, 3vw, 2.75rem); font-weight: 600; }
  .board-rows .up dd { color: var(--yellow); }
  .kaggle-slip { grid-column: 2 / 8; grid-row: 1; margin-top: 16%; rotate: -1.2deg; padding-right: calc(clamp(18px, 2.2vw, 32px) + 7vw); }


  /* ---------- videos ---------- */
  .videos { padding-top: var(--space); }
  .videos-sheet { row-gap: 0; }
  .videos-title { grid-column: 1 / 11; justify-self: start; padding: 0.08em 0.14em 0.08em; rotate: -1deg; }
  .videos-intro { grid-column: 7 / 12; margin-top: 14px; z-index: 2; rotate: 0.8deg; }
  .videos-intro a { display: inline-block; margin-top: 8px; font-weight: 650; }
  .reel { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); margin-top: clamp(40px, 6vw, 80px); }
  .frame-link { display: block; text-decoration: none; color: inherit; }
  .frame-img { display: block; aspect-ratio: 16 / 9; overflow: hidden; }
  .frame-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .frame-slip { display: grid; gap: 6px; padding: 12px 16px; margin: -18px 0 0 14px; position: relative; width: calc(100% - 28px); }
  .frame-date { font-size: 0.8125rem; color: var(--ink-2); }
  .frame-title { font-weight: 700; font-size: 1.0625rem; line-height: 1.3; }
  .frame-link:hover .frame-title { text-decoration: underline; text-decoration-color: var(--teal); text-underline-offset: 0.2em; }
  .frame-0 { grid-column: 1 / 5; grid-row: 1; rotate: -1.2deg; }
  .frame-1 { grid-column: 5 / 9; grid-row: 1; margin-top: 7vw; rotate: 1deg; z-index: 2; }
  .frame-2 { grid-column: 9 / 13; grid-row: 1; margin-top: 2.5vw; rotate: -0.6deg; }

  .videos-screen { grid-column: 3 / 11; grid-row: 3; height: 70%; align-self: end; z-index: 0; }
  .reel { position: relative; z-index: 1; grid-row: 3; }

  /* ---------- writing ---------- */
  .writing { padding-top: var(--space); }
  .writing-sheet { row-gap: 0; }
  .writing-title { grid-column: 6 / 13; justify-self: end; padding: 0.08em 0.14em 0.08em; rotate: 1.2deg; }
  .writing-slip { grid-column: 2 / 10; margin-top: 14px; rotate: -0.4deg; }
  .posts { display: grid; margin-bottom: 22px; }
  .posts li { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: 18px; padding: 14px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .posts time { font-size: 0.875rem; color: var(--ink-2); }
  .posts a { font-weight: 650; font-size: 1.125rem; line-height: 1.35; text-decoration-color: transparent; }
  .posts a:hover { text-decoration-color: var(--teal); }
  .writing-slip .action { background: var(--base); }

  /* ---------- experience ---------- */
  .experience { padding-top: var(--space); }
  .exp-sheet { row-gap: 0; }
  .exp-title { grid-column: 1 / 9; justify-self: start; padding: 0.08em 0.14em 0.08em; rotate: -1deg; }
  .exp-slip { grid-column: 4 / 12; margin-top: 14px; rotate: 0.5deg; }
  .exp-screen { grid-column: 9 / 13; grid-row: 2; height: 60%; margin-top: 18%; z-index: 0; }
  .exp-slip { position: relative; z-index: 1; grid-row: 2; }
  .ledger { display: grid; }
  .ledger li { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr) auto; gap: 18px; padding: 13px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .ledger li:first-child { border-top: 1.5px solid var(--ink); }
