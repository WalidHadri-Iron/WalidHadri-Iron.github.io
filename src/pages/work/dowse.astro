---
import Base from "../../layouts/Base.astro";
import Clip from "../../components/Clip.astro";
import Marks from "../../components/Marks.astro";
import Icon from "../../components/Icon.astro";
import Reg from "../../components/Reg.astro";
import { getStars } from "../../lib/feeds";

const stars = await getStars();
const nav = [
  { label: "Home", href: "/" },
  { label: "How it works", href: "#how" },
  { label: "Speed", href: "#speed" },
];
const queryTokens = ["can", " I", " keep", " a", " dog", " in", " the", " flat"];
// A fixed pattern for the illustrative vector, so every build draws the same plate.
const cells = Array.from({ length: 48 }, (_, i) => ((Math.sin(i * 12.9898) * 43758.5453) % 1 + 1) % 1);
const bench = [
  ["A photo", "49 ms", "347 ms"],
  ["A screenshot, with its words (OCR)", "114 ms", "722 ms"],
  ["A PDF, 32 ms a page", "306 ms", "6,996 ms"],
  ["A document: Office, notes, e-mail, code", "58 ms", "1,335 ms"],
  ["A recording, 202 ms a minute", "336 ms", "4,804 ms"],
  ["A video, 467 ms a minute", "523 ms", "3,700 ms"],
];
---
<Base
  title="Dowse · Walid Hadri"
  description="Dowse finds anything on your PC by what's in it: local, private semantic search for Windows, built on EmbeddingGemma 2 and llama.cpp."
  nav={nav}
>
  <section class="case-hero" data-section aria-labelledby="dowse-h">
    <div class="sheet case-sheet">
      <Marks />
      <h1 id="dowse-h" class="film film--teal case-title register spot" style="--mx:-12px;--my:8px" data-depth="-0.04">
        <span class="display case-word">Dowse</span><Reg />
      </h1>
      <div class="slip case-slip register" style="--mx:10px;--my:-8px;--d:120ms" data-depth="-0.04">
        <Marks />
        <p class="lede">Find anything on your PC by what's in it.</p>
        <dl class="brief">
          <div><dt class="label">Problem</dt><dd>Windows search only matches file names, and nobody remembers what <span class="mono">IMG_0011.jpg</span> is.</dd></div>
          <div><dt class="label">Built</dt><dd>A Windows app that reads photos, screenshots, PDFs, documents, recordings and videos, then finds them from a description in any of 100+ languages.</dd></div>
          <div><dt class="label">Stack</dt><dd>EmbeddingGemma 2 through llama.cpp, on the graphics card (Vulkan) or the processor. Windows OCR for screenshots. Python.</dd></div>
          <div><dt class="label">Result</dt><dd>974 files, 548 MB, read in 2 min 27 s on an RTX 4070 Ti. Open source, {stars["dowse"] ?? 16} stars, plus {stars["dowse-obsidian"] ?? 19} for the Obsidian plugin.</dd></div>
        </dl>
        <div class="actions">
          <a class="action action--yellow" href="https://github.com/WalidHadri-Iron/dowse">Source and download <Icon name="arrow" /></a>
          <a class="action" href="https://github.com/WalidHadri-Iron/dowse-obsidian">Obsidian plugin <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="case-clip" data-depth="0.08">
        <Clip src="/media/dowse-describe.mp4" poster="/media/dowse-describe.webp" width={960} height={594}
          alt="Dowse screen recording: typing 'photos of a yellow tram in Lisbon' finds IMG_0011.jpg." develop="in" />
      </div>
    </div>
  </section>

  <section class="how" id="how" data-section aria-labelledby="how-h">
    <div class="sheet how-sheet">
      <h2 id="how-h" class="title how-title film film--ink spot" data-depth="-0.03">How a search works<Reg /></h2>
      <ol class="steps">
        <li class="step film film--ink spot" data-depth="-0.03">
          <span class="step-n mono">1</span>
          <h3 class="step-h">You describe it</h3>
          <p class="query mono">can I keep a dog in the flat</p>
          <p class="step-p">In your own words, in any language. Results come as you type.</p>
        </li>
        <li class="step film film--teal spot" data-depth="0.04">
          <span class="step-n mono">2</span>
          <h3 class="step-h">Pieces of words</h3>
          <p class="qtok" aria-label="The query split into tokens">
            {queryTokens.map((t) => <span class="mono">{t.trim()}</span>)}
          </p>
          <p class="step-p">The model reads tokens, not words.</p>
        </li>
        <li class="step film film--ink spot" data-depth="-0.05">
          <span class="step-n mono">3</span>
          <h3 class="step-h">One vector</h3>
          <span class="vec" aria-hidden="true">{cells.map((c) => <i style={`opacity:${(0.12 + c * 0.88).toFixed(2)}`}></i>)}</span>
          <p class="step-p">EmbeddingGemma 2 places the meaning in the same space as every photo, page and recording it has read.</p>
        </li>
        <li class="step slip spot" data-depth="0.05">
          <span class="step-n mono">4</span>
          <h3 class="step-h">The closest file</h3>
          <ol class="hits">
            <li><b>Lease.pdf</b> <span class="mono">page 4, Pets</span></li>
            <li class="muted">House rules.docx</li>
            <li class="muted">IMG_2041.jpg</li>
          </ol>
          <p class="step-p">The lease opens at the pets clause.</p>
        </li>
      </ol>
      <p class="how-note muted">Illustration of the pipeline. The token split and vector are drawn for clarity; the lease search is the example from Dowse's own documentation.</p>
    </div>
  </section>

  <section class="seen" data-section aria-label="Dowse at work">
    <div class="sheet seen-sheet">
      <div class="seen-a" data-depth="-0.05">
        <Clip src="/media/dowse-documents.mp4" poster="/media/dowse-documents.webp" width={960} height={594}
          alt="Searching 'can I keep a dog in the flat' finds the lease; up close, the page with its pets clause." />
        <p class="slip caption"><span class="label">Inside documents</span> At the right page, with your words marked.</p>
      </div>
      <div class="seen-b" data-depth="0.06">
        <Clip src="/media/dowse-moment.mp4" poster="/media/dowse-moment.webp" width={960} height={594}
          alt="Searching 'how many months for an emergency fund' finds a podcast at 0:25." />
        <p class="slip caption"><span class="label">Sound and video</span> The podcast plays from 0:25, where it's said.</p>
      </div>
    </div>
  </section>

  <section class="speed" id="speed" data-section aria-labelledby="speed-h">
    <div class="sheet speed-sheet">
      <h2 id="speed-h" class="title speed-title film film--teal spot" data-depth="-0.03">Speed<Reg /></h2>
      <div class="slip speed-slip" data-depth="-0.03">
        <Marks />
        <p>Reading happens once; after that only new or changed files are read, seconds after they appear. Average time for one file:</p>
        <div class="table-wrap">
          <table class="bench">
            <thead><tr><th scope="col">File</th><th scope="col">Graphics card</th><th scope="col">Processor only</th></tr></thead>
            <tbody>
              {bench.map(([k, g, c]) => <tr><th scope="row">{k}</th><td class="mono" data-label="Graphics card">{g}</td><td class="mono" data-label="Processor only">{c}</td></tr>)}
              <tr class="total"><th scope="row">Any file, in this library's mix</th><td class="mono" data-label="Graphics card">147 ms</td><td class="mono" data-label="Processor only">2,712 ms</td></tr>
            </tbody>
          </table>
        </div>
        <p class="muted small">Measured with Dowse's <span class="mono">scripts/benchmark.py</span> on a demo library of 974 made-up files: AMD Ryzen 9 7900X, 32 GB, NVIDIA GeForce RTX 4070 Ti, Windows 10.</p>
        <a class="action" href="/">Back to all work <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .case-hero { padding-top: calc(104px + env(safe-area-inset-top, 0px)); }
  .case-sheet { row-gap: 0; align-items: start; }
  .case-title { grid-column: 1 / 8; grid-row: 1; justify-self: start; padding: 0.06em 0.12em 0.06em; rotate: -1.4deg; margin: 0; }
  .case-word { font-size: clamp(5.5rem, 22vw, 19rem); color: var(--ink); }
  .case-slip { grid-column: 1 / 7; grid-row: 2; margin-top: 14px; z-index: 2; rotate: 0.4deg; }
  .brief { display: grid; margin-top: 18px; border-top: 1.5px solid var(--ink); }
  .brief div { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .brief dt { color: var(--ink-2); padding-top: 3px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .actions .action:not(.action--yellow) { background: var(--base); }
  .case-clip { grid-column: 8 / 13; grid-row: 1 / 3; margin-top: 22%; rotate: 1.2deg; z-index: 3; }

  .how { padding-top: var(--space); }
  .how-sheet { row-gap: 0; }
  .how-title { grid-column: 1 / 11; justify-self: start; padding: 0.08em 0.14em 0.08em; rotate: 0.8deg; }
  .steps { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); margin-top: clamp(32px, 4vw, 56px); align-items: start; }
  .step { padding: 20px; display: grid; gap: 14px; align-content: start; min-width: 0; }
  .step:nth-child(1) { rotate: -1.2deg; color: var(--paper); }
  .step:nth-child(2) { rotate: 0.8deg; margin-top: 4vw; }
  .step:nth-child(3) { rotate: -0.6deg; margin-top: 1.5vw; color: var(--paper); }
  .step:nth-child(4) { rotate: 1deg; margin-top: 5vw; }
  .step-n { font-size: 0.8125rem; }
  .step-h { font-stretch: 75%; font-weight: 820; font-size: clamp(1.5rem, 2.2vw, 2rem); line-height: 1; text-transform: uppercase; }
  .step-p { font-size: 0.9375rem; line-height: 1.45; }
  .query { background: var(--paper); color: var(--ink); padding: 10px 12px; font-size: 0.9375rem; }
  .qtok { display: flex; flex-wrap: wrap; gap: 5px; }
  .qtok span { background: var(--paper); color: var(--ink); padding: 3px 6px; font-size: 0.875rem; }
  .vec { display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; }
  .vec i { aspect-ratio: 1; max-width: 100%; background: var(--teal); }
  .hits { display: grid; gap: 6px; font-size: 0.9375rem; }
  .hits li:first-child { background: var(--yellow); padding: 6px 8px; margin-inline: -8px; }
  .hits .mono { font-size: 0.8125rem; margin-left: 6px; }
  .how-note { grid-column: 1 / 9; margin-top: 28px; font-size: 0.875rem; }

  .seen { padding-top: var(--space); }
  .seen-a { grid-column: 1 / 8; rotate: -1deg; }
  .seen-b { grid-column: 6 / 13; margin-top: 18vw; rotate: 1.2deg; z-index: 2; grid-row: 1; }
  .seen-a { grid-row: 1; }
  .caption { padding: 10px 14px; font-size: 0.9375rem; width: max-content; max-width: 100%; margin: -10px 0 0 18px; position: relative; rotate: -1.2deg; }
  .caption .label { margin-right: 6px; color: var(--teal-ink); }

  .speed { padding-top: var(--space); }
  .speed-sheet { row-gap: 0; }
  .speed-title { grid-column: 4 / 10; justify-self: start; padding: 0.08em 0.14em 0.08em; rotate: -1deg; }
  .speed-slip { grid-column: 2 / 12; margin-top: 14px; rotate: 0.3deg; }
  .table-wrap { overflow-x: auto; margin: 18px 0; }
  .bench { border-collapse: collapse; width: 100%; min-width: 520px; font-size: 0.9375rem; }
  .bench th, .bench td { text-align: left; padding: 11px 12px 11px 0; border-bottom: 1px solid var(--line); }
  .bench thead th { font-stretch: 82%; font-weight: 700; font-size: 0.8125rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-2); border-bottom: 1.5px solid var(--ink); }
  .bench tbody th { font-weight: 500; }
  .bench td { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .bench .total th, .bench .total td { font-weight: 700; background: var(--yellow); }
  .bench .total th { padding-left: 8px; }
  .small { font-size: 0.875rem; margin-bottom: 18px; }
  .speed-slip .action { background: var(--base); }

  @media (max-width: 860px) {
    .case-title, .case-slip, .case-clip, .how-title, .how-note, .seen-a, .seen-b, .speed-title, .speed-slip { grid-column: 1 / -1; grid-row: auto; }
    .case-clip { margin-top: 28px; }
    .steps { grid-template-columns: 1fr 1fr; }
    .step:nth-child(n) { margin-top: 0; }
    .seen-b { margin-top: 28px; }
  }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; }
    .brief div { grid-template-columns: 1fr; gap: 4px; }
    .table-wrap { overflow: visible; }
    .bench { min-width: 0; }
    .bench thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .bench tr { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
    .bench th, .bench td { border: 0; padding: 0; }
    .bench tbody th { grid-column: 1 / -1; font-weight: 650; }
    .bench td::before { content: attr(data-label); display: block; font-family: var(--font); font-size: 0.75rem; color: var(--ink-2); }
    .bench .total { background: var(--yellow); padding: 12px 8px; }
    .bench .total th { padding-left: 0; }
  }
</style>
